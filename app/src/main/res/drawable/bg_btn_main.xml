<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3000FF66">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22252F"
                android:endColor="#15171D"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#343946" />
        </shape>
    </item>
</ripple>
